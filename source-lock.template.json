{
  "schema_version": 1,
  "repositories": {
    "cpue": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-cpue-demo",
      "commit": "6dbc4910a00862f3bab332f02d4d665817496519",
      "checkout": "components/cpue",
      "jobs": [
        "submission",
        "qc",
        "database",
        "extract",
        "cpue_a",
        "cpue_b",
        "cpue_summary",
        "cpue_report"
      ]
    },
    "assessment": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-assessment-demo",
      "commit": "19b66e3e19d475eb320addb055ec23bb3e8e35a4",
      "checkout": "components/assessment",
      "jobs": [
        "prepare_a",
        "prepare_b",
        "assessment_a1",
        "assessment_a2",
        "assessment_b1",
        "assessment_b2",
        "assessment_summary",
        "assessment_report"
      ]
    },
    "mse": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-mse-demo",
      "commit": "22fcdade9f0a8a76edad1ce5253d235f053bc51a",
      "checkout": "components/mse",
      "jobs": [
        "mse_prepare",
        "mse_constant",
        "mse_index",
        "mse_buffered",
        "mse_summary",
        "mse_report"
      ]
    }
  },
  "libraries": {
    "cpue": {
      "repository": "cpue",
      "path": "R/cpue.R"
    },
    "assessment": {
      "repository": "assessment",
      "path": "R/assessment.R"
    },
    "mse": {
      "repository": "mse",
      "path": "R/mse.R"
    }
  }
}
