{
  "schema_version": 1,
  "repositories": {
    "cpue": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-cpue-demo",
      "commit": "cba0a50179ad629d7e4df33734f198d6e9900b36",
      "checkout": "components/cpue",
      "jobs": [
        "submission",
        "qc",
        "database",
        "extract",
        "cpue_a",
        "cpue_b",
        "cpue_summary",
        "cpue_report"
      ]
    },
    "assessment": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-assessment-demo",
      "commit": "0fa5dcfa5db194cd0610ca0d47f4cff6c0494212",
      "checkout": "components/assessment",
      "jobs": [
        "prepare_a",
        "prepare_b",
        "assessment_a1",
        "assessment_a2",
        "assessment_b1",
        "assessment_b2",
        "assessment_summary",
        "assessment_report"
      ]
    },
    "mse": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-mse-demo",
      "commit": "24c47d6f755f390f9e1865d7ec762d87d796937d",
      "checkout": "components/mse",
      "jobs": [
        "mse_prepare",
        "mse_constant",
        "mse_index",
        "mse_buffered",
        "mse_summary",
        "mse_report"
      ]
    }
  },
  "libraries": {
    "cpue": {
      "repository": "cpue",
      "path": "R/cpue.R"
    },
    "assessment": {
      "repository": "assessment",
      "path": "R/assessment.R"
    },
    "mse": {
      "repository": "mse",
      "path": "R/mse.R"
    }
  }
}
