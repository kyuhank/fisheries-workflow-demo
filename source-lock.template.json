{
  "schema_version": 1,
  "repositories": {
    "cpue": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-cpue-demo",
      "commit": "6ae03144434e26a8e70a403f4384bf8251b4eb8f",
      "checkout": "components/cpue",
      "jobs": [
        "submission",
        "qc",
        "database",
        "extract",
        "cpue_a",
        "cpue_b",
        "cpue_summary",
        "cpue_report"
      ]
    },
    "assessment": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-assessment-demo",
      "commit": "9b30d4f6d2afbaddc68ab31d83911b308037cb02",
      "checkout": "components/assessment",
      "jobs": [
        "prepare_a",
        "prepare_b",
        "assessment_a1",
        "assessment_a2",
        "assessment_b1",
        "assessment_b2",
        "assessment_summary",
        "assessment_report"
      ]
    },
    "mse": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-mse-demo",
      "commit": "af0aac308321d7111b5c49b84e00a00188a5e769",
      "checkout": "components/mse",
      "jobs": [
        "mse_prepare",
        "mse_constant",
        "mse_index",
        "mse_buffered",
        "mse_summary",
        "mse_report"
      ]
    }
  },
  "libraries": {
    "cpue": {
      "repository": "cpue",
      "path": "R/cpue.R"
    },
    "assessment": {
      "repository": "assessment",
      "path": "R/assessment.R"
    },
    "mse": {
      "repository": "mse",
      "path": "R/mse.R"
    }
  }
}
