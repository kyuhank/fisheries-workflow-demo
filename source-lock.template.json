{
  "schema_version": 1,
  "repositories": {
    "cpue": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-cpue-demo",
      "commit": "d2b313016f138a3eac8e8841390f035c53c0167d",
      "checkout": "components/cpue",
      "jobs": [
        "submission",
        "qc",
        "database",
        "extract",
        "cpue_a",
        "cpue_b",
        "cpue_summary",
        "cpue_report"
      ]
    },
    "assessment": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-assessment-demo",
      "commit": "5e71b8942a1f00d05c9acdd62ce095eb89b28e8f",
      "checkout": "components/assessment",
      "jobs": [
        "prepare_a",
        "prepare_b",
        "assessment_a1",
        "assessment_a2",
        "assessment_b1",
        "assessment_b2",
        "assessment_summary",
        "assessment_report"
      ]
    },
    "mse": {
      "repository": "https://github.com/kyuhank/fisheries-workflow-mse-demo",
      "commit": "b1e618d9cebd9fffe1b8715ab4fa58f63e804762",
      "checkout": "components/mse",
      "jobs": [
        "mse_prepare",
        "mse_constant",
        "mse_index",
        "mse_buffered",
        "mse_summary",
        "mse_report"
      ]
    }
  },
  "libraries": {
    "cpue": {
      "repository": "cpue",
      "path": "R/cpue.R"
    },
    "assessment": {
      "repository": "assessment",
      "path": "R/assessment.R"
    },
    "mse": {
      "repository": "mse",
      "path": "R/mse.R"
    }
  }
}
