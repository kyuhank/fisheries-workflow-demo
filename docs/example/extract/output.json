{"catch_n":12645,"cell":"25S_175E","fleet":"FJ","hooks":1339511,"quarter":3,"set_id":"wcpfc_ll_row_73817","source_row":73817,"stratum":"25S_175E_Q3","year":2021}],"sql":"-- Published aggregates, not individual fishing sets. Keep the fixed observed support.\nSELECT set_id, source_row, year, fleet, quarter, cell, stratum, hooks, catch_n\nFROM sets\nWHERE fleet = 'FJ' AND hooks > 0 AND catch_n >= 0\n  AND stratum IN ('20S_170E_Q4', '20S_175E_Q1', '20S_175E_Q2',\n                  '20S_175E_Q3', '20S_175E_Q4', '25S_175E_Q3')\nORDER BY year, cell, quarter, source_row;\n\n-- Toy extraction: annual removals feed assessment input preparation directly.\nSELECT year, catch_t\nFROM removals\nORDER BY year;\n"}