atch_t": 67641}, {"year": 2007, "catch_t": 60199}, {"year": 2008, "catch_t": 63577}, {"year": 2009, "catch_t": 84688}, {"year": 2010, "catch_t": 84415}, {"year": 2011, "catch_t": 65954}, {"year": 2012, "catch_t": 87737}, {"year": 2013, "catch_t": 87982}, {"year": 2014, "catch_t": 68543}, {"year": 2015, "catch_t": 72254}, {"year": 2016, "catch_t": 74039}, {"year": 2017, "catch_t": 94499}, {"year": 2018, "catch_t": 81430}, {"year": 2019, "catch_t": 77823}, {"year": 2020, "catch_t": 72604}, {"year": 2021, "catch_t": 70329}], "sql": "-- Published aggregates, not individual fishing sets. Keep the fixed observed support.\nSELECT set_id, source_row, year, fleet, quarter, cell, stratum, hooks, catch_n\nFROM sets\nWHERE fleet = 'FJ' AND hooks > 0 AND catch_n >= 0\n  AND stratum IN ('20S_170E_Q4', '20S_175E_Q1', '20S_175E_Q2',\n                  '20S_175E_Q3', '20S_175E_Q4', '25S_175E_Q3')\nORDER BY year, cell, quarter, source_row;\n\n-- Toy extraction: annual removals feed assessment input preparation directly.\nSELECT year, catch_t\nFROM removals\nORDER BY year;\n", "data_kind": "public-wcpfc-albacore", "metadata": {"title": "South Pacific albacore: a small public-data example", "observation_unit": "Released fleet\u2013quarter\u20135-degree-cell aggregate", "set_id_meaning": "Original CSV row key; not a fishing set", "cpue_scope": "Fiji fleet; six observed cell\u2013quarter strata, 2000\u20132022", "catch_scope": "South Pacific albacore nominal catch estimates; all gears and fleets", "years": [2000, 2022], "reference_strata": ["20S_170E_Q4", "20S_175E_Q1", "20S_175E_Q2", "20S_175E_Q3", "20S_175E_Q4", "25S_175E_Q3"], "prediction_effort_hooks": 1000, "prediction_weights": [0.166666666666667, 0.166666666666667, 0.166666666666667, 0.166666666666667, 0.166666666666667, 0.166666666666667], "normalisation": "First supplied year = 1", "units": {"hooks": "hooks; source HHOOKS multiplied by 100", "catch_n": "albacore in numbers", "catch_t": "metric tonnes"}, "sources": [{"file": "dat